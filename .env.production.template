# ==========================================
# VERIDEX PRODUCTION CLOUD CONFIGURATION
# ==========================================
# Copy this file to .env.production and fill in your cloud service credentials.

# ------------------------------------------
# 1. PostgreSQL (e.g. Supabase, Neon)
# ------------------------------------------
# Example: supabase.com -> Settings -> Database -> Connection string
POSTGRES_SERVER=aws-0-us-west-1.pooler.supabase.com
POSTGRES_USER=postgres.[project_ref]
POSTGRES_PASSWORD=your-super-secret-db-password
POSTGRES_DB=postgres
POSTGRES_PORT=6543
# Optional: if using a connection pooler URL directly
DATABASE_URL_POOLER=postgresql://postgres.[project_ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# ------------------------------------------
# 2. Redis (e.g. Upstash, Render)
# ------------------------------------------
# Example: upstash.com -> Redis -> Connect -> URL
REDIS_SERVER=rediss://default:your-upstash-password@apt-monkey-3456.upstash.io:3456
REDIS_PORT=6379

# ------------------------------------------
# 3. Vector Database (Qdrant Cloud)
# ------------------------------------------
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key

# ------------------------------------------
# 4. Graph Database (Neo4j AuraDB)
# ------------------------------------------
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password

# ------------------------------------------
# 5. Object Storage (AWS S3 or Cloudflare R2)
# ------------------------------------------
MINIO_ENDPOINT=https://your-bucket-endpoint.s3.amazonaws.com
MINIO_ACCESS_KEY=your-aws-access-key
MINIO_SECRET_KEY=your-aws-secret-key
MINIO_BUCKET=veridex-production-data

# ------------------------------------------
# 6. LLM Providers & Integrations
# ------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------
# 7. Internal System Settings
# ------------------------------------------
SECRET_KEY=generate_a_random_string_using_openssl_rand_hex_32
FERNET_SECRET_KEY=generate_using_cryptography_fernet_generate_key
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
OPA_URL=http://opa:8181
